/* rofi for Qubes OS dom0 - the hyprliquid fuzzel launcher, rebuilt for X11.
 *
 * Install: ~/.config/rofi/config.rasi and qubes-menu.py in dom0.
 * Run:     rofi -show qubes -modi "qubes:$HOME/.config/rofi/qubes-menu.py"
 *          (qubes first, then the chosen qube's apps)
 *     or:  rofi -show drun   (every app at once, "qube: app" names)
 *
 * Sizes are fuzzel's, measured off a screenshot of fuzzel running the
 * hyprliquid fuzzel.ini at scale 1, in a 454 px square:
 *
 *   padding  8 px top and bottom, 24 px left and right (inside the border)
 *   rows     15, 27 px each, no gaps; the prompt line is one more row
 *   text     Inter 22 px; icons 20 px; text starts 15 px after the icon
 *   border   3 px, radius 42
 *
 * rofi draws the border and the rounded corners itself, so picom has to use
 * the same radius for this window - see docs/rofi.md.
 */

configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Adwaita";

    /* Name only. The default format adds the generic name in Pango markup,
     * and app names come from the qubes. */
    drun-display-format: "{name}";
    /* What fuzzel searched too: "browser" finds Firefox. */
    drun-match-fields: "name,generic,comment,categories,keywords";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";

    /* 16.5 pt at 96 dpi = 22 px, the size fuzzel draws with dpi-aware=no */
    dpi: 96;
    display-drun: ">";
}

* {
    /* Installed by the polybar bundle: Inter with tabular digits. */
    font: "Inter Tab 16.5";

    /* Dark glass, the terminal's and mako's #14141a at 72%. fuzzel's white
     * 6% veil only worked because Hyprland dimmed the desktop behind it;
     * without that, white text on a white page disappears. */
    veil:      #14141ab8;
    text:      #f5f5f7e6;
    prompt:    #ffffff80;
    hint:      #ffffff50;
    bright:    #ffffffff;
    selection: #ffffff26;
    rim:       #ffffff40;

    background-color: transparent;
    text-color: @text;
    spacing: 0;
}

window {
    /* Draw with the window's own alpha; picom blurs what is behind it. */
    transparency: "real";
    location: center;
    /* A fixed square: it never follows the number of matches. */
    width: 454px;
    height: 454px;
    background-color: @veil;
    border: 3px;
    border-color: @rim;
    border-radius: 42px;
    padding: 8px 24px;
}

mainbox, inputbar, listview, message {
    border: 0;
}

mainbox {
    children: [ inputbar, listview ];
}

/* Same 16 px inset as the rows, so ">" lines up with the icons. */
inputbar {
    /* trimmed to 27 px like the rows below */
    padding: -1px 16px -2px 16px;
    children: [ prompt, textbox-prompt-sep, entry ];
}

prompt {
    text-color: @prompt;
    expand: false;
}

/* fuzzel's prompt is "> " - the space before the typed text */
textbox-prompt-sep {
    str: " ";
    expand: false;
}

entry {
    text-color: @bright;
    placeholder: "";
    placeholder-color: @hint;
    cursor: text;
}

listview {
    lines: 15;
    fixed-height: true;
    scrollbar: false;
}

/* fuzzel: selection-radius 21 (a 27 px row caps it at half its height).
 * The negative padding trims the font's full line height (30 px in rofi)
 * to fuzzel's 27 px row; glyphs are not clipped. */
element {
    padding: -1px 16px -2px 16px;
    spacing: 15px;
    border-radius: 21px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @text;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selection;
    text-color: @bright;
}

element-icon {
    size: 20px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    /* Matched letters, like fuzzel's match colour */
    highlight: bold #ffffff;
}
